{
  "name": "worksy",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "a monorepo for developing a gigs marketplace.",
  "license": "AGPL-3.0-or-later",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "prepare": "node ./scripts/setup-githooks.js",
    "all:format": "prettier . --write",
    "client:dev": "npm run dev --workspace=apps/client",
    "client:build": "npm run build --workspace=apps/client",
    "client:format": "npm run format --workspace=apps/client",
    "client:lint": "npm run lint --workspace=apps/client",
    "server:dev": "npm run dev --workspace=apps/server",
    "server:build": "npm run build --workspace=apps/server",
    "server:format": "npm run format --workspace=apps/server",
    "server:lint": "npm run lint --workspace=apps/server"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.5.0",
    "lint-staged": "16.2.6",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.47.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chingu-voyages/V58-tier3-team-33.git"
  },
  "homepage": "https://github.com/chingu-voyages/v58-tier3-team-33#readme",
  "contributors": [
    "See contributors at https://github.com/chingu-voyages/v58-tier3-team-33/graphs/contributors"
  ]
}
